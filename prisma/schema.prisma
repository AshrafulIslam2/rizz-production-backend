generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum HeroType {
  IMAGE
  VIDEO
}

enum FaqAnswerType {
  TEXT
  SHORT
  LIST
  STEPS
  COMPARISON
  TABLE
  DEFINITION
}

enum FaqIntentType {
  DEFINITION
  PRICING
  HOW_TO
  COMPARISON
  SHIPPING
  CARE
  RETURN_POLICY
  AVAILABILITY
  TROUBLESHOOTING
}

enum FaqFactCheckStatus {
  PENDING
  VERIFIED
  NEEDS_REVIEW
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PromotionType {
  BOGO
  PERCENTAGE_DISCOUNT
  FLAT_DISCOUNT
  BUNDLE
  FREE_SHIPPING
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum PromotionConditionType {
  MIN_QTY
  MIN_CART_VALUE
  PRODUCT_INCLUDED
  CATEGORY_INCLUDED
  BRAND_INCLUDED
  USER_SEGMENT
  REGION
  PAYMENT_METHOD
  FIRST_ORDER_ONLY
}

enum PromotionTargetType {
  PRODUCT
  CATEGORY
  BRAND
}

enum PromotionBenefitType {
  PERCENTAGE_DISCOUNT
  FLAT_DISCOUNT
  BOGO
  FREE_SHIPPING
  BUNDLE
}

enum PromotionDiscountUnit {
  PERCENT
  AMOUNT
}

enum PromotionApplyTo {
  ORDER
  ITEM
  SHIPPING
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(VIEWER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  parentId  String?
  parent    Page?    @relation("PageChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Page[]   @relation("PageChildren")
  hero      Hero?
  faqs      Faq[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([parentId, order])
}

model Hero {
  id                 String   @id @default(cuid())
  pageId             String   @unique
  page               Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type               HeroType
  backgroundImageUrl String?
  backgroundVideoUrl String?
  slogan             String?
  title              String
  subtitle           String?
  keyPoints          String[]
  isActive           Boolean  @default(true)
  order              Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Faq {
  id                String              @id @default(cuid())
  page_id           String
  page              Page                @relation(fields: [page_id], references: [id], onDelete: Cascade)
  question          String
  answer            String
  short_answer      String
  answer_type       FaqAnswerType
  intent_type       FaqIntentType
  seo_title         String
  seo_description   String
  slug              String
  schema_enabled    Boolean             @default(true)
  ai_summary        String
  entity_tags       String[]
  source_url        String
  fact_check_status FaqFactCheckStatus
  last_verified_at  DateTime
  context           String
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  @@unique([page_id, slug])
  @@index([page_id])
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String?
  parent_id       String?
  parent          Category?  @relation("CategoryChildren", fields: [parent_id], references: [id], onDelete: Cascade)
  children        Category[] @relation("CategoryChildren")
  products        Product[]
  is_active       Boolean    @default(true)
  is_featured     Boolean    @default(false)
  show_on_homepage Boolean   @default(false)
  thumbnail_image String?
  banner_image    String?
  seo_title       String?
  seo_description String?
  page_intro      String?
  extra_faq       Json?
  order           Int        @default(0)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  @@index([parent_id, order])
}

model Product {
  id                String        @id @default(cuid())
  sku               String        @unique
  name              String
  slug              String        @unique
  short_description String?
  description       String?
  key_features      String[]
  materials         String[]
  specifications    Json?
  use_cases         String[]
  how_to_use        String?
  benefits          String[]
  problem_solved    String?
  specs             String?
  craftsmanship     String?
  free_delivery     Boolean       @default(false)
  brand_id          String        @default("")
  category_id       String?
  category          Category?     @relation(fields: [category_id], references: [id], onDelete: Restrict)
  price             Float?
  compare_at_price  Float?
  sale_price        Float?
  status            ProductStatus @default(DRAFT)
  is_featured       Boolean       @default(false)
  is_published      Boolean       @default(false)
  tags              String[]
  gender            String?
  age_group         String?
  material          String?
  tax_class         String?
  weight            Float?
  length            Float?
  width             Float?
  height            Float?
  meta_title        String?
  meta_description  String?
  variants          ProductVariant[]
  media             ProductMedia[]
  images            ProductImage[]
  seo               ProductSeo?
  translations      ProductTranslation[]
  faqs              ProductFaq[]
  reviews           ProductReview[]
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  @@index([category_id])
  @@index([brand_id])
  @@index([status, is_published])
}

model ProductVariant {
  id           String        @id @default(cuid())
  product_id   String
  product      Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sku          String        @unique
  variant_name String
  price            Float
  sale_price       Float?
  production_price Float?
  stock_qty        Int           @default(0)
  attributes   Json
  barcode      String?
  is_default   Boolean       @default(false)
  status       ProductStatus @default(DRAFT)
  images             ProductImage[]
  media              ProductMedia[]
  inventory_movements InventoryMovement[]
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  @@index([product_id])
  @@index([status, is_default])
}

model ProductImage {
  id          String         @id @default(cuid())
  product_id  String
  product     Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant_id  String?
  variant     ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  image_url   String
  alt_text    String?
  is_primary  Boolean        @default(false)
  sort_order  Int            @default(0)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  @@index([product_id, sort_order])
  @@index([variant_id])
  @@index([is_primary])
}

enum MediaType {
  IMAGE
  VIDEO
}

model ProductMedia {
  id            String         @id @default(cuid())
  product_id    String
  product       Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant_id    String?
  variant       ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  media_type    MediaType
  media_url     String
  thumbnail_url String?
  alt_text      String?
  title         String?
  sort_order    Int            @default(0)
  is_primary    Boolean        @default(false)
  is_featured   Boolean        @default(false)
  status        ProductStatus  @default(DRAFT)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  @@index([product_id, sort_order])
  @@index([variant_id])
  @@index([is_primary])
  @@index([is_featured])
  @@index([status])
}

model ProductSeo {
  product_id       String  @unique
  product          Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  meta_title       String
  meta_description String
  meta_keywords    String?
  canonical_url    String?
  slug             String  @unique
  og_title         String?
  og_description   String?
  og_image         String?
  schema_json      Json?
}

model ProductTranslation {
  id                String  @id @default(cuid())
  product_id        String
  product           Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  lang_code         String
  name              String
  short_description String?
  description       String?
  seo_title         String?
  seo_description   String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([product_id, lang_code])
  @@index([lang_code])
}

model ProductFaq {
  id         String  @id @default(cuid())
  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  question   String
  answer     String
  lang_code  String  @default("en")
  order      Int     @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([product_id, order])
  @@index([product_id, lang_code])
}

model ProductReview {
  id                 String   @id @default(cuid())
  product_id         String
  product            Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer_name      String
  customer_image_url String?
  comment            String?
  rating             Int?
  status             String   @default("pending")
  image_urls         String[]
  video_urls         String[]
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([product_id])
  @@index([status])
}

model Promotion {
  id             String           @id @default(cuid())
  name           String
  code           String           @unique
  type           PromotionType
  status         PromotionStatus  @default(DRAFT)
  start_at       DateTime?
  end_at         DateTime?
  priority       Int              @default(0)
  stackable      Boolean          @default(false)
  usage_limit    Int?
  per_user_limit Int?
  conditions     PromotionCondition[]
  targets        PromotionTarget[]
  benefits       PromotionBenefit[]
  redemptions    PromotionRedemption[]
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  @@index([status, start_at, end_at])
  @@index([priority])
}

model PromotionCondition {
  id             String    @id @default(cuid())
  promotion_id   String
  promotion      Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  condition_type PromotionConditionType
  operator       String
  value          String
  extra_value    String?
  created_at     DateTime  @default(now())

  @@index([promotion_id])
  @@index([condition_type])
}

model PromotionTarget {
  id            String              @id @default(cuid())
  promotion_id  String
  promotion     Promotion           @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  target_type   PromotionTargetType
  target_id     String
  created_at    DateTime            @default(now())

  @@index([promotion_id])
  @@index([target_type, target_id])
}

model PromotionBenefit {
  id                  String               @id @default(cuid())
  promotion_id        String
  promotion           Promotion            @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  benefit_type        PromotionBenefitType
  discount_value      Float?
  discount_unit       PromotionDiscountUnit?
  max_discount_amount Float?
  buy_qty             Int?
  get_qty             Int?
  apply_to            PromotionApplyTo?
  created_at          DateTime             @default(now())

  @@index([promotion_id])
  @@index([benefit_type])
}

model PromotionRedemption {
  id              String    @id @default(cuid())
  promotion_id    String
  promotion       Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  user_id         String?
  order_id        String?
  redeemed_at     DateTime  @default(now())
  discount_amount Float?

  @@index([promotion_id])
  @@index([user_id])
  @@index([order_id])
}

model Order {
  id              String   @id @default(cuid())
  order_number    String   @unique
  customer_name   String
  customer_phone  String
  customer_email  String?
  division        String?
  district        String?
  area            String?
  address         String
  items           Json
  subtotal        Float
  shipping_fee    Float    @default(0)
  discount_amount Float    @default(0)
  promo_code      String?
  campaign_ids    String[] @default([])
  free_gifts      Json?
  total           Float
  payment_method  String   @default("COD")
  status          String   @default("pending")
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([status])
  @@index([order_number])
}

model Setting {
  key        String   @id
  value      Json
  updated_at DateTime @updatedAt
}

model CheckoutLead {
  id           String   @id @default(cuid())
  name         String?
  phone        String
  email        String?
  cart_total   Float?
  source       String   @default("checkout")
  company_name String?
  status       String   @default("new")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([phone])
  @@index([status])
}

model ProductView {
  id         String   @id @default(cuid())
  product_id String
  session_id String
  last_seen  DateTime @updatedAt

  @@unique([product_id, session_id])
  @@index([product_id, last_seen])
}

model Campaign {
  id                    String    @id @default(cuid())
  name                  String
  type                  String    @default("promotion")
  code                  String?   @unique
  requires_code         Boolean   @default(false)
  discount_type         String?
  discount_value        Float?
  buy_qty               Int?
  get_qty               Int?
  free_shipping         Boolean   @default(false)
  free_gift_product_id  String?
  usage_limit           Int?
  used_count            Int       @default(0)
  product_ids           String[]  @default([])
  start_date            DateTime?
  end_date              DateTime?
  is_active             Boolean   @default(true)
  image_url             String?
  headline              String?
  body                  String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
}

model BlogPost {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  description  String?
  category     String    @default("General")
  reading_time Int       @default(5)
  cover_image  String?
  cover_alt    String?
  body         Json      @default("[]")
  is_published Boolean   @default(false)
  published_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([is_published])
  @@index([slug])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

enum MovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  DAMAGE
  SALE
  RETURN
}

model InventoryMovement {
  id         String         @id @default(cuid())
  variant_id String
  variant    ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  type       MovementType
  quantity   Int
  before_qty Int
  after_qty  Int
  reference  String?
  note       String?
  created_at DateTime       @default(now())

  @@index([variant_id])
  @@index([type])
  @@index([created_at])
}

// ─── Suppliers & Purchase Orders ──────────────────────────────────────────────

model Supplier {
  id              String          @id @default(cuid())
  name            String
  phone           String?
  email           String?
  address         String?
  note            String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  purchase_orders PurchaseOrder[]
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  po_number   String    @unique
  supplier_id String?
  supplier    Supplier? @relation(fields: [supplier_id], references: [id])
  status      String    @default("pending")
  items       Json
  total_cost  Float
  note        String?
  received_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([status])
  @@index([supplier_id])
}

// ─── POS Transactions ─────────────────────────────────────────────────────────

model PosTransaction {
  id              String   @id @default(cuid())
  tx_number       String   @unique
  customer_name   String?
  customer_phone  String?
  items           Json
  subtotal        Float
  discount_amount Float    @default(0)
  discount_type   String   @default("flat")
  total           Float
  payment_cash    Float    @default(0)
  payment_card    Float    @default(0)
  payment_mobile  Float    @default(0)
  status          String   @default("completed")
  note            String?
  created_at      DateTime @default(now())

  @@index([status])
  @@index([customer_phone])
  @@index([created_at])
}

// ─── Returns & Exchanges ──────────────────────────────────────────────────────

model ReturnExchange {
  id             String   @id @default(cuid())
  ref_number     String   @unique
  type           String
  original_tx    String?
  customer_name  String?
  customer_phone String?
  items          Json
  exchange_items Json?
  refund_amount  Float    @default(0)
  status         String   @default("pending")
  note           String?
  created_at     DateTime @default(now())

  @@index([status])
  @@index([type])
}

// ─── CRM Customers ────────────────────────────────────────────────────────────

model CrmCustomer {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?
  address      String?
  total_spend  Float    @default(0)
  total_orders Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([phone])
}

// ─── Production Costing (Wholesale + Retail) ──────────────────────────────────

/// Which part of the costing form a field belongs to.
enum CostSection {
  UPPER           // Tab 2 — upper materials, entered per dozen
  SOLE            // Tab 3 — sole materials, entered per dozen
  FACTORY         // Tab 4 — labour + factory overhead, entered per dozen
  RETAIL_COMMON   // Monthly shop expenses, divided by expected monthly sales
  RETAIL_PRODUCT  // Per-product retail extras (box, bag), already per pair
}

/// How the amount typed into a field should be interpreted.
///
/// Needed because one costing form mixes three kinds of money: materials
/// bought by the dozen, shop and factory bills that arrive monthly, and
/// per-pair extras like a gift box. Storing the basis per field means the admin decides, instead of
/// the code guessing.
enum CostBasis {
  PER_DOZEN /// Amount already covers one dozen pairs. Used as-is.
  PER_PAIR  /// Amount is for a single pair. Used as-is (retail extras).
  PER_MONTH /// Monthly bill. Divided by monthly output to reach a per-unit cost.
}

/// How a field's cost is worked out from its inputs.
///
/// Four reusable calculators cover every footwear material we cost, so adding
/// a new material later means picking a calculator rather than writing a new
/// formula.
enum CostCalculator {
  DIRECT   /// A plain per-dozen amount typed straight in.
  SQFT     /// used sq.ft x cost per sq.ft  (leather, lining)
  UNIT     /// quantity x cost per unit     (foam, cover, goj/yard items)
  SHEET    /// (sheet price / pairs per sheet) x 12  (texon, SRS, EVA, soles)
  CHEMICAL /// (container price / container qty) x used per dozen
}

/// A single user-managed costing field.
///
/// The whole costing form is driven by these rows rather than hardcoded
/// inputs, so fields can be added, renamed, reordered, disabled or archived
/// from the admin without a code change. `key` is the stable identifier used
/// inside ProductCosting.values — renaming the label never breaks saved data.
model CostFieldDefinition {
  id          String      @id @default(cuid())
  section     CostSection
  basis       CostBasis   @default(PER_DOZEN)
  calculator  CostCalculator @default(DIRECT)
  /// Sub-tab within the section, e.g. "materials", "insole", "chemicals".
  /// Null groups render before the tabs.
  group       String?
  /// Shown only when its group is switched to this mode ("HANDMADE" /
  /// "READYMADE"). Null means always shown.
  mode        String?
  key         String      @unique
  label       String
  /// Optional hint shown under the input.
  help_text   String?
  sort_order  Int         @default(0)
  /// false = hidden from the form but existing values are kept.
  is_active   Boolean     @default(true)
  /// Archived fields stay out of the form and out of new totals.
  is_archived Boolean     @default(false)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  @@index([section, sort_order])
  @@index([is_active, is_archived])
}

/// One costing record per product.
///
/// `values` maps CostFieldDefinition.key -> amount. Everything in UPPER, SOLE
/// and FACTORY is entered PER DOZEN (1 dozen = 12 pairs); RETAIL_PRODUCT
/// entries are per pair. The derived figures below are recomputed on every
/// save so the production list can be rendered without re-running the maths
/// for each row.
model ProductCosting {
  id           String  @id @default(cuid())
  /// Optional link to the catalog product this costing belongs to.
  product_id   String?
  product_name String
  product_code String?
  category     String?
  image_url    String?
  entry_date   DateTime @default(now())

  /// fieldKey -> amount. Missing key means the admin left it blank (= 0).
  values Json @default("{}")

  /// Pairs this design yields in a month if the factory ran nothing else.
  ///
  /// This is a STANDARD, set once per design and edited only when efficiency
  /// really changes — not an actual monthly output figure to be re-entered.
  /// It is what the shop-wide factory bills are divided by, so a slow design
  /// automatically carries more overhead per pair than an easy one.
  standard_capacity_pairs Float @default(0)

  /// The same capacity in dozens. Derived on save; kept for older readers.
  monthly_production Float @default(0)

  /// Snapshot of the shop-wide monthly factory pool used at save time, so the
  /// stored per-dozen figures can always be traced back to a total.
  factory_monthly_total Float @default(0)

  wholesale_profit_pct Float @default(0)
  retail_profit_pct    Float @default(0)

  /// Snapshot of the retail common cost per pair at save time, so an old
  /// costing record keeps the numbers it was actually saved with even after
  /// the shop's monthly expenses change.
  retail_common_cost_pair Float @default(0)

  // ── Derived (recomputed server-side on every write) ──
  upper_cost_dozen       Float @default(0)
  sole_cost_dozen        Float @default(0)
  factory_cost_dozen     Float @default(0)
  production_cost_dozen  Float @default(0)
  production_cost_pair   Float @default(0)
  wholesale_profit_pair  Float @default(0)
  wholesale_price_pair   Float @default(0)
  wholesale_price_dozen  Float @default(0)
  retail_product_cost_pair Float @default(0)
  retail_cost_pair       Float @default(0)
  retail_profit_pair     Float @default(0)
  retail_price_pair      Float @default(0)
  retail_price_dozen     Float @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([product_id])
  @@index([updated_at])
}
