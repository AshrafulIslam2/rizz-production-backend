DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rizz_admin_panel?schema=public"
PORT=3000
NODE_ENV=development

# Shared secret the admin panel's server-side proxy sends as `x-admin-key`.
# Must be at least 32 characters and identical in rizz_admin_panel/.env.local.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If missing, every admin route returns 401 (the storefront keeps working).
ADMIN_API_KEY=

# Optional. Comma-separated origins allowed to call the API from a browser.
# Defaults to https://rizzleather.com, https://www.rizzleather.com, https://admin.rizzleather.com
# CORS_ORIGINS=https://rizzleather.com,https://www.rizzleather.com,https://admin.rizzleather.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
